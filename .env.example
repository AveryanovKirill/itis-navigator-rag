LLM_PROVIDER=ollama
# Qwen фиксирована в коде; другую модель этот проект не выбирает.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Исходный стартовый порог. На другом корпусе его качество не гарантируется.
# Пусто = локальная калибровка reports/threshold.json, если она существует.
THRESHOLD=0.817020058631897
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Цены за миллион токенов в USD: заполните по актуальному тарифу своего провайдера.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
HW2_BUDGET=
